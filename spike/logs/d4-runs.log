          '\n' +
          '  // Returns p50/p95/p99 for a timing series, or zeros if empty. Nearest-rank\n' +
          '  // method — good enough for in-memory dashboards, not for billing.\n' +
          '  percentiles(name: string): { p50: number; p95: number; p99: number } {\n' +
          '    const arr = [...(this.timings.get(name) ?? [])].sort((a, b) => a - b);\n' +
          '    if (arr.length === 0) return { p50: 0, p95: 0, p99: 0 };\n' +
          '    const at = (q: number) => arr[Math.min(arr.length - 1, Math.floor(q * arr.length))];\n' +
          '    return { p50: at(0.5), p95: at(0.95), p99: at(0.99) };\n' +
