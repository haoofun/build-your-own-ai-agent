          'export type Level = "debug" | "info" | "warn" | "error";\n' +
          '\n' +
          'const ORDER: Record<Level, number> = {\n' +
          '  debug: 10,\n' +
          '  info: 20,\n' +
          '  warn: 30,\n' +
          '  error: 40,\n' +
          '};\n' +
          '\n' +
          '// Lines below the configured threshold are dropped. The sink defaults to\n' +
          '// console.log but is injectable so tests can capture output.\n' +
          'export class Logger {\n' +
          '  constructor(\n' +
          '    private threshold: Level = "info",\n' +
          '    private sink: (line: string) => void = console.log,\n' +
          '  ) {}\n' +
          '\n' +
          '  private emit(level: Level, msg: string): void {\n' +
          '    if (ORDER[level] < ORDER[this.threshold]) return;\n' +
          '    const ts = new Date().toISOString();\n' +
          '    this.sink(`${ts} [${level.toUpperCase()}] ${msg}`);\n' +
          '  }\n' +
          '\n' +
          '  debug(m: string): void { this.emit("debug", m); }\n' +
          '  info(m: string): void { this.emit("info", m); }\n' +
          '  warn(m: string): void { this.emit("warn", m); }\n' +
          '  error(m: string): void { this.emit("error", m); }\n' +
          '\n' +
          '  // A child logger prefixes every line, handy for per-task scoping.\n' +
          '  child(prefix: string): Logger {\n' +
          '    return new Logger(this.threshold, (line) => this.sink(`${prefix} ${line}`));\n' +
          '  }\n' +
          '}\n'
