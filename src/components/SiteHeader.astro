---
import Search from './Search'
import { PARTS, SLUG_TO_N, N_TO_SLUG, chapterStatus, STATUS_META } from '../data/chapters'
interface Props {
  currentPath?: string
}
const { currentPath = Astro.url.pathname } = Astro.props

// 归一化尾斜杠（Astro 默认 trailingSlash:'ignore'，/about 实际服务为 /about/）
const path = currentPath.replace(/\/+$/, '') || '/'
const isOutline = path === '/outline'
const isAbout = path === '/about'
const isReading = path !== '/' && !isOutline && !isAbout
// 抽栏（drawer）里高亮当前章节
const activeSlug = path.replace(/^\/+/, '')
const activeN = SLUG_TO_N[activeSlug]
---

<header class="site-header">
  <div class="site-header-left">
    <button class="nav-toggle" id="nav-toggle" aria-label="打开导航菜单" aria-expanded="false" aria-controls="nav-drawer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <a href="/" class="site-brand">Build Your Own AI Agent</a>
    <nav class="site-nav">
      <a href="/00-intro" aria-current={isReading ? 'page' : undefined}>指南</a>
      <a href="/outline" aria-current={isOutline ? 'page' : undefined}>大纲</a>
      <a href="/about" aria-current={isAbout ? 'page' : undefined}>关于</a>
    </nav>
  </div>
  <div class="site-header-right">
    <Search client:load />

    <a href="https://github.com/haoofun/build-your-own-ai-agent" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub" class="hdr-icon-link hdr-github">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
      </svg>
    </a>

    <!-- language switcher -->
    <div class="lang-wrap" id="lang-wrap">
      <button class="hdr-icon-link lang-btn" id="lang-btn" aria-label="切换语言" aria-expanded="false">
        <i data-lucide="languages" style="width:18px;height:18px"></i>
        <i data-lucide="chevron-down" style="width:13px;height:13px;opacity:0.6"></i>
      </button>
      <div class="lang-dropdown" id="lang-dropdown" hidden>
        <div class="lang-dropdown-label">切换语言</div>
        <a class="lang-option lang-option--active">
          <span>简体中文</span>
          <span class="lang-note">当前</span>
        </a>
        <a class="lang-option" href="#" onclick="return false" style="opacity:0.5;cursor:default">
          <span>English</span>
          <span class="lang-note">WIP</span>
        </a>
      </div>
    </div>

    <button id="theme-toggle" class="hdr-icon-link" aria-label="切换明暗主题" title="切换主题">
      <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
      </svg>
      <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</header>

<!-- 移动端导航抽栏（≤900px）：站点链接 + 完整章节目录 -->
<div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
<aside class="nav-drawer" id="nav-drawer" aria-label="站点导航" aria-hidden="true">
  <div class="nav-drawer-head">
    <span class="nav-drawer-brand">Build Your Own AI Agent</span>
    <button class="nav-drawer-close" id="nav-close" aria-label="关闭导航菜单">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="nav-drawer-body">
    <nav class="nav-drawer-links" aria-label="主导航">
      <a href="/00-intro" aria-current={isReading ? 'page' : undefined}>指南</a>
      <a href="/outline" aria-current={isOutline ? 'page' : undefined}>大纲</a>
      <a href="/about" aria-current={isAbout ? 'page' : undefined}>关于</a>
      <a href="https://github.com/haoofun/build-your-own-ai-agent" target="_blank" rel="noopener">GitHub ↗</a>
    </nav>

    <div class="nav-drawer-chapters">
      {PARTS.map((group) => (
        <div class="sidebar-group">
          <div class="sidebar-group-label">{group.part} · {group.title}</div>
          {group.chapters.map((ch) => {
            const chSlug = N_TO_SLUG[ch.n]
            const isActive = ch.n === activeN
            const status = chapterStatus(ch.n)
            return (
              <a
                href={chSlug ? `/${chSlug}` : '#'}
                class="sidebar-item"
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="sidebar-item-inner">
                  <span class={`sidebar-status s-${status}`} title={STATUS_META[status].label} aria-label={STATUS_META[status].label}></span>
                  <span class="sidebar-item-num">{ch.n}</span>
                  <span class="sidebar-item-label">{ch.t}</span>
                </span>
              </a>
            )
          })}
        </div>
      ))}
    </div>
  </div>
</aside>

<style>
  .hdr-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: var(--text-3);
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .hdr-icon-link:hover { color: var(--text-1); }

  /* 汉堡按钮：仅 ≤900px 显示 */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-left: -8px;
    color: var(--text-2);
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .nav-toggle:hover { color: var(--text-1); background: var(--bg-soft); }

  /* language dropdown */
  .lang-wrap { position: relative; }
  .lang-btn { gap: 3px; }
  .lang-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 20;
    min-width: 168px;
    padding: 4px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .lang-dropdown[hidden] { display: none; }
  .lang-dropdown-label {
    padding: 5px 10px 6px;
    font-size: var(--text-2xs);
    color: var(--text-3);
    letter-spacing: 0.04em;
  }
  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--text-2);
    font-weight: 400;
    background: transparent;
  }
  .lang-option--active {
    color: var(--text-1);
    font-weight: 600;
    background: var(--bg-soft);
  }
  .lang-note {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
  }

  /* ── 移动导航抽栏 ─────────────────────────────────────────────── */
  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--overlay);
    backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.26s var(--ease), visibility 0.26s var(--ease);
  }
  .nav-backdrop.open { opacity: 1; visibility: visible; }

  .nav-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 60;
    width: min(310px, 84vw);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-right: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.3s;
    padding-top: env(safe-area-inset-top);
  }
  .nav-drawer.open { transform: none; visibility: visible; }

  .nav-drawer-head {
    flex: none;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 12px 0 18px;
    border-bottom: 1px solid var(--border);
  }
  .nav-drawer-brand {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nav-drawer-close {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--text-3);
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .nav-drawer-close:hover { color: var(--text-1); background: var(--bg-soft); }

  .nav-drawer-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 16px 12px calc(28px + env(safe-area-inset-bottom));
  }

  .nav-drawer-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .nav-drawer-links a {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .nav-drawer-links a:hover { color: var(--text-1); background: var(--bg-soft); }
  .nav-drawer-links a[aria-current='page'] { color: var(--text-1); font-weight: 600; background: var(--bg-soft); }

  /* 抽栏内章节项稍微放大点击区（复用全局 .sidebar-* 视觉） */
  .nav-drawer-chapters :global(.sidebar-item) { padding-top: 8px; padding-bottom: 8px; }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }
    .site-nav { display: none; }
    .hdr-github,
    .lang-wrap { display: none; }
  }

  @media (min-width: 901px) {
    .nav-backdrop,
    .nav-drawer { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-backdrop,
    .nav-drawer { transition: none; }
  }
</style>

<style is:global>
  /* 头部：移动端收紧内距与间距，让品牌名与必要控件并排不溢出 */
  @media (max-width: 900px) {
    .site-header { padding: 0 14px; gap: 8px; }
    .site-header-left { gap: 8px; min-width: 0; flex: 1; }
    .site-brand {
      font-size: 15px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .site-header-right { gap: 4px; flex: none; }
  }
  @media (max-width: 380px) {
    .site-brand { font-size: 14px; }
  }
  /* 抽栏开启时锁滚动 */
  body.nav-open { overflow: hidden; }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    var sun = document.getElementById('icon-sun');
    var moon = document.getElementById('icon-moon');

    function applyTheme(t) {
      root.setAttribute('data-theme', t);
      localStorage.setItem('byoa-theme', t);
      if (sun && moon) {
        sun.style.display = t === 'dark' ? 'block' : 'none';
        moon.style.display = t === 'dark' ? 'none' : 'block';
      }
    }

    var cur = root.getAttribute('data-theme') || 'dark';
    applyTheme(cur);

    if (btn) {
      btn.addEventListener('click', function () {
        applyTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });
    }

    // language dropdown
    var langBtn = document.getElementById('lang-btn');
    var langDropdown = document.getElementById('lang-dropdown');
    if (langBtn && langDropdown) {
      langBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = !langDropdown.hidden;
        langDropdown.hidden = open;
        langBtn.setAttribute('aria-expanded', String(!open));
      });
      document.addEventListener('click', function () {
        langDropdown.hidden = true;
        langBtn.setAttribute('aria-expanded', 'false');
      });
    }

    // 移动导航抽栏
    var navToggle = document.getElementById('nav-toggle');
    var navClose = document.getElementById('nav-close');
    var navDrawer = document.getElementById('nav-drawer');
    var navBackdrop = document.getElementById('nav-backdrop');
    if (navToggle && navDrawer && navBackdrop) {
      function openDrawer() {
        navDrawer.classList.add('open');
        navBackdrop.classList.add('open');
        navDrawer.setAttribute('aria-hidden', 'false');
        navToggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('nav-open');
      }
      function closeDrawer() {
        navDrawer.classList.remove('open');
        navBackdrop.classList.remove('open');
        navDrawer.setAttribute('aria-hidden', 'true');
        navToggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('nav-open');
      }
      navToggle.addEventListener('click', openDrawer);
      if (navClose) navClose.addEventListener('click', closeDrawer);
      navBackdrop.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDrawer();
      });
      // 点击任一抽栏链接后关闭（同页锚点/跳转都收起）
      navDrawer.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', closeDrawer);
      });
      // 跨过桌面断点时确保抽栏关闭、解除滚动锁
      window.matchMedia('(min-width: 901px)').addEventListener('change', function (e) {
        if (e.matches) closeDrawer();
      });
    }
  })();
</script>
