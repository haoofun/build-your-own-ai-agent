---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Footer from '../components/Footer.astro'

const positioning = [
  {
    vs: '对标 · 付费课',
    lead: '免费，而且走得更深。',
    body: 'CodeCrafters 的《Build your own Claude Code》止步于 Read / Write / Bash + 基础 loop。本书免费开源，一路走到上下文压缩、子 agent、MCP、skills、评测——多数教程停下的地方，正是这本书的后半程。',
  },
  {
    vs: '对标 · 成品导读',
    lead: '从空文件渐进式构建，不是逆向导读。',
    body: '不像 learn-claude-code 或成品导读式项目那样摊开成品代码讲解。本书每一章从上一章的可运行版本出发，只加一个能力，代码按章打 git tag，随时能 diff 对照、逐行看懂。',
  },
  {
    vs: '对标 · 使用教程',
    lead: '讲内部机制，不是用法。',
    body: 'tool use 就是一段 JSON、loop 就是重发数组、MCP 就是 JSON-RPC——把这些「黑魔法」拆成你能亲手复刻的协议，而不是教你怎么用现成的 agent 工具。',
  },
]

const siblings = [
  { t: 'Build your own Redis', d: '从零实现一个支持并发的内存数据库' },
  { t: 'Build your own Git', d: '复刻对象存储、commit 与分支模型' },
  { t: 'Build your own Docker', d: '用 namespace / cgroup 手写容器运行时' },
  { t: 'Build your own Shell', d: '实现一个能跑管道与内建命令的 shell' },
  { t: 'Build your own HTTP Server', d: '从 socket 起手写一个 Web 服务器' },
  { t: 'Build your own Interpreter', d: '为一门小语言写词法、语法与求值器' },
]
---

<BaseLayout
  title="关于 — Build Your Own AI Agent"
  description="一本免费开源的 build-your-own-x 风格教程，用 TypeScript 从零手写一个编码 agent"
>
  <SiteHeader />

  <main class="about-main" id="main-content">
    <div class="about-inner">
      <div class="about-eyebrow">// 关于本项目</div>
      <h1 class="about-title">一本免费、开源的「从零复刻」教程</h1>
      <p class="about-lead">
        《Build Your Own AI Agent》是一本 <strong>build-your-own-x</strong> 风格的教学项目：用
        ~2500 行 TypeScript、不依赖任何 agent 框架，渐进式地手写出一个具备 agent loop、文件读写、shell
        执行、权限确认、上下文压缩、子 agent 与 MCP 能力的编码 agent。
      </p>

      <div class="about-cta-row">
        <a href="/00-intro" class="btn btn-primary">开始阅读</a>
        <a href="/outline" class="btn btn-secondary">查看课程大纲</a>
        <a href="https://github.com/haoofun/build-your-own-ai-agent" target="_blank" rel="noopener" class="btn btn-secondary">在 GitHub 查看</a>
      </div>

      <h2 class="about-h2">和同类的区别</h2>
      <div class="pos-list">
        {positioning.map((p) => (
          <div class="pos-row">
            <div class="pos-vs">{p.vs}</div>
            <div class="pos-body">
              <strong>{p.lead}</strong> {p.body}
            </div>
          </div>
        ))}
      </div>

      <h2 class="about-h2">给个 star</h2>
      <div class="star-block">
        <p class="star-lead">
          如果这本书帮到了你——让你真正看懂 agent 是怎么跑起来的，或者少踩了几个坑——就在 GitHub 点个
          <strong>star</strong> 吧。它免费、开源、没有付费墙；star 是它能被更多人看到、也是我把它逐章写完的动力。
        </p>
        <a href="https://github.com/haoofun/build-your-own-ai-agent" target="_blank" rel="noopener" class="star-btn">
          <i data-lucide="star"></i>
          在 GitHub 点个 star
        </a>
      </div>

      <h2 class="about-h2">许可</h2>
      <div class="license-rows">
        <div class="license-row">
          <span class="license-badge">代码</span>
          <span><strong>MIT</strong> —— 随意使用、修改、分发。</span>
        </div>
        <div class="license-row">
          <span class="license-badge">书稿</span>
          <span><strong>CC BY-NC-SA 4.0</strong> —— 署名、非商业、相同方式共享。</span>
        </div>
      </div>

      <h2 class="about-h2">「Build Your Own X」系列</h2>
      <p class="about-series-lead">
        本项目属于经典的「亲手复刻」流派——通过从零重写一个你每天在用的工具，真正理解它。下面是同流派的代表作，均收录于
        <a href="https://github.com/codecrafters-io/build-your-own-x" target="_blank" rel="noopener">codecrafters-io/build-your-own-x</a>：
      </p>
      <ul class="siblings-list">
        {siblings.map((s) => (
          <li class="sibling-row">
            <span class="sibling-title">{s.t}</span>
            <span class="sibling-desc">{s.d}</span>
          </li>
        ))}
      </ul>

      <div class="about-footer-note">
        <span>// 书稿文字 CC BY-NC-SA 4.0 · 代码 MIT · © 2026 haoo</span>
        <span>// 状态：写作进行中 · 章节将逐章发布</span>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-main { padding: 56px 24px 96px; }
  .about-inner { max-width: 720px; margin: 0 auto; }

  .about-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .about-title {
    font-size: var(--text-h1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    line-height: 1.3;
    margin: 0 0 16px;
  }
  .about-lead {
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-2);
    margin: 0 0 28px;
  }
  .about-lead strong { color: var(--text-1); font-weight: 600; }

  .about-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 56px; }

  .about-h2 {
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--text-1);
    margin: 0 0 16px;
  }

  /* ── 定位 / 和同类的区别 ───────────────────────────────────── */
  .pos-list { margin: 0 0 52px; }
  .pos-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 8px 28px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }
  .pos-row:last-child { border-bottom: 1px solid var(--border); }
  @media (max-width: 600px) { .pos-row { grid-template-columns: 1fr; gap: 8px; } }
  .pos-vs {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    line-height: 1.5;
    padding-top: 3px;
  }
  .pos-body { font-size: var(--text-sm); line-height: 1.7; color: var(--text-2); }
  .pos-body strong { color: var(--text-1); font-weight: 600; }

  /* ── 许可 ──────────────────────────────────────────────────── */
  .license-rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 52px; }
  .license-row {
    display: flex; align-items: center; gap: 12px;
    font-size: var(--text-body); color: var(--text-2);
  }
  .license-row strong { color: var(--text-1); font-weight: 600; }
  .license-badge {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: var(--text-2xs);
    color: var(--text-3); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 2px 8px;
    flex: none;
  }

  /* ── BYOX 系列 ─────────────────────────────────────────────── */
  .about-series-lead {
    font-size: var(--text-body); line-height: 1.75;
    color: var(--text-2); margin: 0 0 16px;
  }
  .about-series-lead a {
    color: var(--text-1); text-decoration: underline;
    text-decoration-color: var(--border); text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  .about-series-lead a:hover { text-decoration-color: var(--text-1); }

  .siblings-list { list-style: none; margin: 0 0 52px; padding: 0; }
  .sibling-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 2px;
    border-top: 1px solid var(--border);
  }
  .sibling-row:last-child { border-bottom: 1px solid var(--border); }
  .sibling-title { font-size: var(--text-sm); font-weight: 600; color: var(--text-1); flex: none; min-width: 200px; }
  .sibling-desc { font-size: var(--text-sm); color: var(--text-3); line-height: 1.5; }
  @media (max-width: 520px) {
    .sibling-row { flex-direction: column; gap: 3px; }
    .sibling-title { min-width: 0; }
  }

  .about-footer-note {
    display: flex; flex-direction: column; gap: 4px;
    padding-top: 20px; border-top: 1px solid var(--border);
    font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-3);
  }

  /* ── star 区 ───────────────────────────────────────────────── */
  .star-block { margin-bottom: 52px; }
  .star-lead {
    font-size: var(--text-body); line-height: 1.75;
    color: var(--text-2); margin: 0 0 20px;
  }
  .star-lead strong { color: var(--text-1); font-weight: 600; }
  .star-btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 10px 18px; border-radius: var(--radius-sm);
    background: var(--text-1); color: var(--bg);
    font-size: var(--text-sm); font-weight: 600;
    text-decoration: none; border: 1px solid var(--text-1);
    transition: opacity var(--duration-fast) var(--ease);
  }
  .star-btn:hover { opacity: 0.88; }
  .star-btn :global(svg) { width: 16px; height: 16px; }
</style>
