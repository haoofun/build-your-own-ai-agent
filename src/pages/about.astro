---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Footer from '../components/Footer.astro'

const siblings = [
  { t: 'Build your own Redis', d: '从零实现一个支持并发的内存数据库' },
  { t: 'Build your own Git', d: '复刻对象存储、commit 与分支模型' },
  { t: 'Build your own Docker', d: '用 namespace/cgroup 手写容器运行时' },
  { t: 'Build your own Shell', d: '实现一个能跑管道与内建命令的 shell' },
  { t: 'Build your own HTTP Server', d: '从 socket 起手写一个 Web 服务器' },
  { t: 'Build your own Interpreter', d: '为一门小语言写词法、语法与求值器' },
]
---

<BaseLayout
  title="关于 — Build Your Own AI Agent"
  description="一本免费开源的 build-your-own-x 风格教程，用 TypeScript 从零手写一个编码 agent"
>
  <SiteHeader />

  <main class="about-main" id="main-content">
    <div class="about-inner">
      <div class="about-eyebrow">// 关于本项目</div>

      <h1 class="about-title">一本免费、开源的「从零复刻」教程</h1>

      <p class="about-lead">
        《Build Your Own AI Agent》是一本 <strong>build-your-own-x</strong> 风格的教学项目：用
        ~2500 行 TypeScript、不依赖任何 agent 框架，渐进式地手写出一个具备 agent loop、文件读写、shell
        执行、权限确认、上下文压缩、子 agent 与 MCP 能力的编码 agent。
      </p>

      <div class="about-cta-row">
        <a href="https://build-your-own-ai-agent.com" target="_blank" rel="noopener" class="btn btn-primary">
          访问 build-your-own-ai-agent.com
        </a>
        <a href="https://github.com/haoofun/build-your-own-ai-agent" target="_blank" rel="noopener" class="btn btn-secondary">
          在 GitHub 查看
        </a>
      </div>

      <h2 class="about-h2">许可</h2>
      <div class="license-rows">
        <div class="license-row">
          <span class="license-badge">代码</span>
          <span><strong>MIT</strong> —— 随意使用、修改、分发。</span>
        </div>
        <div class="license-row">
          <span class="license-badge">书稿</span>
          <span><strong>CC BY-NC-SA 4.0</strong> —— 署名、非商业、相同方式共享。</span>
        </div>
      </div>

      <h2 class="about-h2">"Build Your Own X" 系列</h2>
      <p class="about-series-lead">
        本项目属于经典的「亲手复刻」流派——通过从零重写一个你每天在用的工具，真正理解它。下面是同流派的一些代表作，收录于
        <a href="https://github.com/codecrafters-io/build-your-own-x" target="_blank" rel="noopener">
          github.com/codecrafters-io/build-your-own-x
        </a>：
      </p>
      <div class="siblings-grid">
        {siblings.map((s) => (
          <div class="sibling-card">
            <div class="sibling-title">{s.t}</div>
            <div class="sibling-desc">{s.d}</div>
          </div>
        ))}
      </div>

      <div class="about-footer-note">
        <span>// 书稿文字 CC BY-NC-SA 4.0 · 代码 MIT · © 2026 haoo</span>
        <span>// 状态：写作进行中 · 章节将逐章发布</span>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-main { padding: 56px 24px 96px; }
  .about-inner { max-width: 720px; margin: 0 auto; }

  .about-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .about-title {
    font-size: var(--text-h1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    line-height: 1.3;
    margin: 0 0 16px;
  }
  .about-lead {
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-2);
    margin: 0 0 28px;
  }
  .about-lead strong { color: var(--text-1); font-weight: 600; }

  .about-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 56px; }

  .about-h2 {
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--text-1);
    margin: 0 0 12px;
  }

  .license-rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 48px; }
  .license-row {
    display: flex; align-items: center; gap: 12px;
    font-size: var(--text-body); color: var(--text-2);
  }
  .license-row strong { color: var(--text-1); font-weight: 600; }
  .license-badge {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: var(--text-2xs);
    color: var(--text-3); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 2px 8px;
    flex: none;
  }

  .about-series-lead {
    font-size: var(--text-body); line-height: 1.75;
    color: var(--text-2); margin: 0 0 20px;
  }
  .about-series-lead a {
    color: var(--text-1); text-decoration: underline;
    text-decoration-color: var(--border); text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  .about-series-lead a:hover { text-decoration-color: var(--text-1); }

  .siblings-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 12px; margin-bottom: 48px;
  }
  @media (max-width: 600px) { .siblings-grid { grid-template-columns: 1fr; } }
  .sibling-card {
    padding: 16px 20px;
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--bg-alt);
    transition: border-color 0.15s;
  }
  .sibling-card:hover { border-color: var(--border-strong); }
  .sibling-title { font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: 4px; }
  .sibling-desc { font-size: var(--text-sm); color: var(--text-3); line-height: 1.5; }

  .about-footer-note {
    display: flex; flex-direction: column; gap: 4px;
    padding-top: 20px; border-top: 1px solid var(--border);
    font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-3);
  }
</style>
