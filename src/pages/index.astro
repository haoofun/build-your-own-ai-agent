---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Footer from '../components/Footer.astro'
import CliDemo from '../components/CliDemo'
import { PARTS, N_TO_SLUG, chapterStatus } from '../data/chapters'

const ladder = PARTS.filter((p) => p.part !== '附录')
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content">
    <!-- ── hero ─────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-inner">
        <div class="badge">// free · open-source · 无付费墙</div>
        <h1>Build Your Own AI&nbsp;Agent</h1>
        <div class="subtitle">从零复刻一个 Claude Code</div>
        <p class="tagline">
          普通 chatbot <strong>回答</strong>你；agent 把同一个模型放进一个循环里——执行、观察、再执行——直到任务<strong>真的完成</strong>。这本书带你用 TypeScript 从零写出那个循环，不靠任何框架。
        </p>
        <div class="cta-row">
          <a href="/00-intro" class="btn btn-primary">开始阅读</a>
          <a href="/outline" class="btn btn-secondary">查看课程大纲</a>
        </div>

        <div class="hero-demo">
          <CliDemo client:load />
        </div>
      </div>
    </section>

    <!-- ── roadmap / capability ladder ──────────────────────── -->
    <section class="roadmap">
      <div class="roadmap-inner">
        <div class="section-head">
          <h2>你将亲手造出什么</h2>
          <p class="section-sub">
            每一章都有一个可运行的里程碑，比上一章明显更强。下面是完整的构建轴——按顺序读，按顺序写。
          </p>
          <p class="roadmap-status">
            <span class="status-dot"></span>
            全书写作中：spike 周已跑通核心能力链，正在写第 0–5 章。结构已定，正文逐章补全、过程公开。
          </p>
        </div>

        <div class="parts">
          {ladder.map((part) => (
            <div class="part">
              <div class="part-head">
                <span class="part-label">{part.part}</span>
                <span class="part-title">{part.title}</span>
                {part.sub && <span class="part-sub">· {part.sub}</span>}
              </div>
              <div class="rungs">
                {part.chapters.map((ch) => {
                  const st = chapterStatus(ch.n)
                  return (
                    <a class="rung" href={`/${N_TO_SLUG[ch.n]}`} data-status={st}>
                      <span class="rung-n">{ch.n}</span>
                      <span class="rung-title">{ch.t}{st === 'writing' && <span class="rung-dot" title="写作中"></span>}</span>
                      <span class="rung-m">{ch.m}</span>
                    </a>
                  )
                })}
              </div>
            </div>
          ))}
        </div>

        <a href="/outline" class="roadmap-more">查看完整大纲（含 16 章 + 3 附录）→</a>
      </div>
    </section>

    <!-- ── differentiation / honesty ────────────────────────── -->
    <section class="diff">
      <div class="diff-inner">
        <div class="section-head">
          <h2>不是源码导读，是从零跟写</h2>
          <p class="section-sub">同类项目要么收费止步、要么照着成品讲。这本书的不同，是诚实地从空文件开始。</p>
        </div>
        <dl class="diff-list">
          <div class="diff-row">
            <dt>免费，而且走得更深</dt>
            <dd>对标的付费课止步于 Read/Write/Bash + 基础 loop。我们免费开源，一路走到上下文压缩、子 agent、MCP、skills、评测——多数教程停下的地方，正是这本书的后半程。</dd>
          </div>
          <div class="diff-row">
            <dt>渐进式构建，逐行看得懂</dt>
            <dd>不是把成品代码摊开导读。每一章从上一章的可运行版本出发，只加一个能力，代码按章打 git tag，随时能 diff 对照。</dd>
          </div>
          <div class="diff-row">
            <dt>讲内部机制，不是用法</dt>
            <dd>tool use 就是一段 JSON、loop 就是重发数组、MCP 就是 JSON-RPC——把「黑魔法」拆成你能亲手复刻的协议。</dd>
          </div>
          <div class="diff-row">
            <dt>照实暴露踩过的坑</dt>
            <dd>spike 周的失败、压缩把问题摘没、子 agent 自信答错——都写进正文，不营造「一切都很顺」的假象。</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ── agent band ───────────────────────────────────────── -->
    <section class="agent-band">
      <div class="agent-band-inner">
        <p class="badge">// 不想自己读？让你的 agent 教你</p>
        <h2 class="agent-band-title">把这本书装进你的编码 agent</h2>
        <p class="agent-band-text">
          交给 Claude Code、Cursor 这类工具，它会装上本书的<strong>陪读 skill</strong>，按章节顺序带你从零写出这个 agent——导师式、苏格拉底式：讲原理、查作业、不替你写核心代码。你随时可以打断提问、要求跳章或重讲。
        </p>
        <div class="cmd-tabs">
          <button class="cmd-tab active" data-idx="0">粘贴给 agent</button>
          <button class="cmd-tab" data-idx="1">命令行</button>
          <button class="cmd-tab" data-idx="2">llms.txt</button>
        </div>
        <div class="copy-block">
          <code class="copy-code" id="cmd-text"></code>
          <button class="copy-btn" id="cmd-copy-btn">复制</button>
        </div>
        <div class="agent-band-status">// 命令行工具与 llms.txt 将于首批章节发布后上线</div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    var _cmds = [
      { text: '安装并运行《Build Your Own AI Agent》的陪读 skill，按本站章节一步步带我学，每章结束前先让我自己动手：\nhttps://build-your-own-ai-agent.com/skill/tutor.md', multi: true },
      { text: 'npx byoaiagent tutor', multi: false },
      { text: 'https://build-your-own-ai-agent.com/llms.txt', multi: false },
    ];
    var _activeIdx = 0;
    function _setCmd(idx) {
      _activeIdx = idx;
      var cmd = _cmds[idx];
      var el = document.getElementById('cmd-text');
      el.textContent = cmd.text;
      cmd.multi ? el.classList.add('multi') : el.classList.remove('multi');
      document.querySelectorAll('.cmd-tab').forEach(function (t, i) {
        t.classList.toggle('active', i === idx);
      });
    }
    _setCmd(0);
    document.querySelectorAll('.cmd-tab').forEach(function (tab, i) {
      tab.addEventListener('click', function () { _setCmd(i); });
    });
    document.getElementById('cmd-copy-btn').addEventListener('click', function () {
      navigator.clipboard.writeText(_cmds[_activeIdx].text).then(function () {
        var btn = document.getElementById('cmd-copy-btn');
        var orig = btn.textContent;
        btn.textContent = '已复制';
        setTimeout(function () { btn.textContent = orig; }, 1500);
      });
    });
  </script>
</BaseLayout>

<style is:global>
  /* ── hero ─────────────────────────────────────────────────────────────── */
  .hero { padding: clamp(48px, 8vw, 88px) 24px clamp(40px, 6vw, 64px); }
  .hero-inner { max-width: 960px; margin: 0 auto; text-align: center; }
  .badge {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-3);
    margin-bottom: 18px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(36px, 6.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--text-1);
    text-wrap: balance;
  }
  .hero .subtitle {
    margin-top: 12px;
    font-size: clamp(18px, 2.6vw, 24px);
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }
  .hero .tagline {
    margin: 18px auto 0;
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-2);
    max-width: 580px;
  }
  .hero .tagline strong { color: var(--text-1); font-weight: 600; }
  .cta-row { display: flex; gap: 12px; margin-top: 26px; justify-content: center; flex-wrap: wrap; }
  .hero-demo { margin-top: clamp(36px, 5vw, 52px); text-align: left; }

  /* ── shared section heads ─────────────────────────────────────────────── */
  .section-head { max-width: 640px; }
  .section-head h2 {
    font-size: clamp(24px, 3.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-1);
    margin: 0;
    text-wrap: balance;
  }
  .section-sub {
    margin-top: 12px;
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--text-2);
  }

  /* ── roadmap ──────────────────────────────────────────────────────────── */
  .roadmap { padding: clamp(56px, 7vw, 88px) 24px; border-top: 1px solid var(--border); }
  .roadmap-inner { max-width: 1080px; margin: 0 auto; }
  .roadmap-status {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-3);
  }
  .status-dot {
    flex: none;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--warning);
    transform: translateY(-1px);
  }

  .parts {
    margin-top: clamp(36px, 5vw, 52px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 64px);
  }
  @media (max-width: 720px) { .parts { grid-template-columns: 1fr; } }

  .part-head {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding-bottom: 12px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .part-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    letter-spacing: 0.02em;
  }
  .part-title { font-size: var(--text-body); font-weight: 600; color: var(--text-1); letter-spacing: -0.01em; }
  .part-sub { font-size: var(--text-xs); color: var(--text-3); }

  .rung {
    display: grid;
    grid-template-columns: 28px 1fr;
    grid-template-areas: 'num title' '. milestone';
    column-gap: 12px;
    row-gap: 2px;
    padding: 11px 8px 11px 4px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease);
  }
  .rung:hover { background: var(--bg-alt); }
  .rung-n {
    grid-area: num;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-3);
    padding-top: 1px;
    transition: color var(--duration-fast) var(--ease);
  }
  .rung:hover .rung-n { color: var(--text-1); }
  .rung-title {
    grid-area: title;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.01em;
  }
  .rung-m {
    grid-area: milestone;
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--text-2);
  }
  .rung-m::before { content: '→ '; color: var(--text-3); }
  .rung-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--warning);
    margin-left: 8px;
    vertical-align: middle;
  }

  .roadmap-more {
    display: inline-block;
    margin-top: clamp(32px, 4vw, 44px);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease), border-color var(--duration-fast) var(--ease);
  }
  .roadmap-more:hover { color: var(--text-1); border-color: var(--text-1); }

  /* ── differentiation ──────────────────────────────────────────────────── */
  .diff { padding: clamp(56px, 7vw, 88px) 24px; border-top: 1px solid var(--border); }
  .diff-inner { max-width: 760px; margin: 0 auto; }
  .diff-list { margin: clamp(28px, 4vw, 40px) 0 0; }
  .diff-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 8px 32px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
  }
  .diff-row:last-child { border-bottom: 1px solid var(--border); }
  @media (max-width: 640px) { .diff-row { grid-template-columns: 1fr; gap: 6px; } }
  .diff-row dt { font-size: var(--text-body); font-weight: 600; color: var(--text-1); letter-spacing: -0.01em; }
  .diff-row dd { margin: 0; font-size: var(--text-sm); line-height: 1.7; color: var(--text-2); }

  /* ── agent band ───────────────────────────────────────────────────────── */
  .agent-band { padding: clamp(56px, 7vw, 88px) 24px; border-top: 1px solid var(--border); }
  .agent-band-inner { max-width: 600px; margin: 0 auto; text-align: center; }
  .agent-band .badge { margin-bottom: 14px; }
  .agent-band-title {
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.02em;
    color: var(--text-1);
    margin: 0;
  }
  .agent-band-text { font-size: 15px; line-height: 1.75; color: var(--text-2); margin: 14px 0 26px; }
  .agent-band-text strong { color: var(--text-1); }

  .cmd-tabs { display: flex; gap: 4px; margin-bottom: 8px; justify-content: center; }
  .cmd-tab {
    padding: 4px 10px;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-3);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .cmd-tab:hover { color: var(--text-2); border-color: var(--text-3); }
  .cmd-tab.active { color: var(--text-1); border-color: var(--text-1); }
  .copy-block {
    display: flex;
    align-items: center;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    max-width: 460px;
    margin: 0 auto;
  }
  .copy-code {
    flex: 1;
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-1);
    background: transparent;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .copy-code.multi {
    white-space: pre-wrap;
    overflow: visible;
    text-overflow: clip;
    font-size: var(--text-xs);
    line-height: 1.5;
  }
  .copy-btn {
    flex-shrink: 0;
    padding: 10px 14px;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-2);
    background: transparent;
    border: 0;
    border-left: 1px solid var(--border);
    cursor: pointer;
    transition: color var(--duration-fast);
  }
  .copy-btn:hover { color: var(--text-1); }
  .agent-band-status {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    text-align: center;
  }
</style>
