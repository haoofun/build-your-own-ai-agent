---
import { Code } from 'astro:components'
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Footer from '../components/Footer.astro'
import CliDemo from '../components/CliDemo'
import Callout from '../components/Callout'
import { PARTS, N_TO_SLUG, chapterStatus } from '../data/chapters'

const ladder = PARTS.filter((p) => p.part !== '附录')

// 「看一眼正文」预览里的真实代码片段——与阅读页同一条 Shiki 双主题管线
const LOOP_TS = `// agent loop 的核心：每一轮都重发整个 messages 数组
async function runAgent(messages: Message[]) {
  while (true) {
    const res = await callModel(messages)
    messages.push(res.message)
    if (res.stopReason !== 'tool_use') return res
    const results = await runTools(res.toolCalls)
    messages.push(...results)
  }
}`
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content">
    <!-- ── hero ─────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-inner">
        <div class="badge">// free · open-source · 无付费墙</div>
        <h1>Build Your Own AI&nbsp;Agent</h1>
        <div class="subtitle">从零复刻一个 Claude Code</div>
        <p class="tagline">
          普通 chatbot <strong>回答</strong>你；agent 把同一个模型放进一个循环里——执行、观察、再执行——直到任务<strong>真的完成</strong>。这本书带你用 TypeScript 从零写出那个循环，不靠任何框架。
        </p>
        <div class="aud" data-mode="human">
          <div class="aud-toggle" role="tablist" aria-label="选择读者身份">
            <span class="aud-thumb" aria-hidden="true"></span>
            <button class="aud-opt active" data-mode="human" role="tab" aria-selected="true" type="button">I'm a Human</button>
            <button class="aud-opt" data-mode="agent" role="tab" aria-selected="false" type="button">I'm an Agent</button>
          </div>

          <div class="aud-panels">
            <div class="aud-panel aud-human active">
              <div class="cta-row">
                <a href="/00-intro" class="btn btn-primary">开始阅读</a>
                <a href="/outline" class="btn btn-secondary">查看课程大纲</a>
              </div>
            </div>
            <div class="aud-panel aud-agent">
              <div class="copy-block">
                <code class="copy-code multi" id="agent-cmd">安装并运行《Build Your Own AI Agent》的陪读 skill，按本站章节一步步带我学，每章结束前先让我自己动手：
https://build-your-own-ai-agent.com/skill/tutor.md</code>
                <button class="copy-btn" id="agent-copy-btn" type="button">复制</button>
              </div>
              <p class="aud-note">// 粘贴给 Claude Code、Cursor 等编码 agent，它会按章带你从零写一个 agent</p>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-demo">
        <CliDemo client:load />
      </div>
    </section>

    <!-- ── roadmap / capability ladder ──────────────────────── -->
    <section class="roadmap">
      <div class="roadmap-inner">
        <div class="section-head">
          <h2>你将亲手造出什么</h2>
          <p class="section-sub">
            每个 Part 都有清楚的出口能力；进入开发后，再把它切成一组可运行、逐步增强的章节。下面的章名是当前展开，不是不会变化的目录合同。
          </p>
          <p class="roadmap-status">
            <span class="status-dot"></span>
            终局能力已定，Part 目标已重排；正在推进序章与第一部分，未发布章节仍可重切。
          </p>
        </div>

        <div class="parts">
          {ladder.map((part) => (
            <div class="part">
              <div class="part-head">
                <span class="part-label">{part.part}</span>
                <span class="part-title">{part.title}</span>
                {part.sub && <span class="part-sub">· {part.sub}</span>}
              </div>
              {part.exit && <p class="part-exit"><span>出口 →</span>{part.exit}</p>}
              <div class="rungs">
                {part.chapters.map((ch) => {
                  const st = chapterStatus(ch.n)
                  return (
                    <a class="rung" href={`/${N_TO_SLUG[ch.n]}`} data-status={st}>
                      <span class="rung-n">{ch.n}</span>
                      <span class="rung-title">{ch.t}{st === 'writing' && <span class="rung-dot" title="写作中"></span>}</span>
                      <span class="rung-m">{ch.m}</span>
                    </a>
                  )
                })}
              </div>
            </div>
          ))}
        </div>

        <a href="/outline" class="roadmap-more">查看 Part 目标与当前章节假设 →</a>
      </div>
    </section>

    <!-- ── 看一眼正文 / 阅读体验预览 ─────────────────────────── -->
    <section class="peek">
      <div class="peek-inner">
        <div class="section-head">
          <h2>翻开是什么样</h2>
          <p class="section-sub">
            阅读体验本身就是这本书的第一个 demo：墨黑标题、灰正文、浅灰代码面、双主题语法高亮、随手展开的 callout。下面是真实排版的一小段。
          </p>
        </div>

        <div class="peek-frame">
          <div class="prose">
            <h3>agent loop 的形状</h3>
            <p>
              普通的一次 API 调用是「一问一答」：你发 <code>messages</code>，拿回一段文本，结束。要让模型真正<strong>做事</strong>，你得把它放进一个循环里，并给它一组工具——执行、观察、再执行，直到它不再请求工具。
            </p>
            <Code code={LOOP_TS} lang="ts" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
            <Callout type="warning" title="一个坑">
              <code>while (true)</code> 没有上界。真实实现里必须有 <code>maxTurns</code> 兜底——否则模型反复请求工具时会无限循环，把你的 API 账单烧穿。
            </Callout>
          </div>
        </div>

        <p class="peek-note">// 正文逐章写作中，过程公开</p>
      </div>
    </section>

    <!-- ── differentiation / honesty ────────────────────────── -->
    <section class="diff">
      <div class="diff-inner">
        <div class="section-head">
          <h2>不是源码导读，是从零跟写</h2>
          <p class="section-sub">同类项目要么收费止步、要么照着成品讲。这本书的不同，是诚实地从空文件开始。</p>
        </div>
        <dl class="diff-list">
          <div class="diff-row">
            <dt>免费，而且走得更深</dt>
            <dd>对标的付费课止步于 Read/Write/Bash + 基础 loop。我们免费开源，一路走到上下文压缩、子 agent、MCP、skills、评测——多数教程停下的地方，正是这本书的后半程。</dd>
          </div>
          <div class="diff-row">
            <dt>渐进式构建，逐行看得懂</dt>
            <dd>不是把成品代码摊开导读。每个 Part 先跑通出口，再切成可运行、逐步增强的章节；发布后按章打 git tag，随时能 diff 对照。</dd>
          </div>
          <div class="diff-row">
            <dt>讲内部机制，不是用法</dt>
            <dd>tool use 就是一段 JSON、loop 就是重发数组、MCP 就是 JSON-RPC——把「黑魔法」拆成你能亲手复刻的协议。</dd>
          </div>
          <div class="diff-row">
            <dt>照实暴露踩过的坑</dt>
            <dd>spike 周的失败、压缩把问题摘没、子 agent 自信答错——都写进正文，不营造「一切都很顺」的假象。</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ── 开始之前 / 门槛 + 成本 + API ─────────────────────── -->
    <section class="before">
      <div class="before-inner">
        <div class="section-head">
          <h2>开始之前</h2>
          <p class="section-sub">门槛低、花费小，拿一把 key 就能跑。没有付费墙，你只为自己的 API 调用付费。</p>
        </div>

        <dl class="before-list">
          <div class="before-row">
            <dt>你需要什么</dt>
            <dd>会任意一门编程语言就够了。书用 TypeScript，但语言只是表达的载体——你会 Go、Python 也一样跟得下来，需要时让你的 agent 把示例转写成你的语言，机制是相通的。再加 <strong>Node 22+</strong> 和一个 <strong>API key</strong>，就能开工。</dd>
          </div>
          <div class="before-row">
            <dt>这要花多少钱</dt>
            <dd>全程只为自己的 API 调用付费。spike 周从头跑通核心能力链，<strong>实测约 $1</strong>；跟完全书预计 <strong>不到 $5</strong>。对照付费同类平台 CodeCrafters 的年订阅约 $990——这本书免费、开源、无付费墙。</dd>
          </div>
          <div class="before-row">
            <dt>用哪个模型</dt>
            <dd>正文用 <strong>Anthropic Messages 格式</strong>：<code>tool_use</code> / <code>tool_result</code> 是消息里显式的 JSON block，「loop 就是重发数组」一一对应，学起来心智负担最低。Anthropic、OpenRouter、DeepSeek 都能直接跑，OpenAI 兼容端点见附录 A。预算敏感推荐 DeepSeek（便宜，且自带 Anthropic 兼容端点）。</dd>
          </div>
        </dl>

        <div class="before-links">
          <a href="/appendix-a-api-providers">附录 A：API 平台与取 key →</a>
          <a href="/00-intro">从第 0 章开始读 →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <script is:inline>
    // 读者身份切换：Human（开始阅读 / 大纲） ⇄ Agent（粘贴陪读 skill 提示词）
    (function () {
      var aud = document.querySelector('.aud');
      if (!aud) return;
      var opts = aud.querySelectorAll('.aud-opt');
      var panels = {
        human: aud.querySelector('.aud-human'),
        agent: aud.querySelector('.aud-agent'),
      };
      function setMode(mode) {
        aud.dataset.mode = mode;
        opts.forEach(function (o) {
          var on = o.dataset.mode === mode;
          o.classList.toggle('active', on);
          o.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        Object.keys(panels).forEach(function (k) {
          panels[k].classList.toggle('active', k === mode);
        });
      }
      opts.forEach(function (o) {
        o.addEventListener('click', function () { setMode(o.dataset.mode); });
      });

      var copyBtn = document.getElementById('agent-copy-btn');
      copyBtn.addEventListener('click', function () {
        var text = document.getElementById('agent-cmd').textContent;
        navigator.clipboard.writeText(text).then(function () {
          var orig = copyBtn.textContent;
          copyBtn.textContent = '已复制';
          setTimeout(function () { copyBtn.textContent = orig; }, 1500);
        });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return; // 默认可见，不 gate

      // 每处揭示贴合它揭示的东西：标题整块、roadmap 按 2 列左右错峰、diff 逐行
      var groups = [
        { sel: '.roadmap .section-head, .diff .section-head, .peek .section-head, .before .section-head', stagger: 0, mod: 1 },
        { sel: '.roadmap .part', stagger: 70, mod: 2 },
        { sel: '.diff-row, .before-row', stagger: 50, mod: 4 },
        { sel: '.peek-frame', stagger: 0, mod: 1 },
      ];

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('reveal-in');
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });

      groups.forEach(function (g) {
        document.querySelectorAll(g.sel).forEach(function (el, i) {
          el.classList.add('reveal-init');
          if (g.stagger) el.style.transitionDelay = (i % g.mod) * g.stagger + 'ms';
          io.observe(el);
        });
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  /* ── hero ─────────────────────────────────────────────────────────────── */
  .hero { padding: clamp(48px, 8vw, 88px) 24px clamp(40px, 6vw, 64px); }
  .hero-inner { max-width: 960px; margin: 0 auto; text-align: center; }
  .badge {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-3);
    margin-bottom: 18px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(36px, 6.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--text-1);
    text-wrap: balance;
  }
  .hero .subtitle {
    margin-top: 12px;
    font-size: clamp(18px, 2.6vw, 24px);
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }
  .hero .tagline {
    margin: 18px auto 0;
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-2);
    max-width: 580px;
  }
  .hero .tagline strong { color: var(--text-1); font-weight: 600; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .hero-demo {
    max-width: 1080px;
    margin: clamp(40px, 5vw, 60px) auto 0;
    text-align: left;
  }

  /* ── 读者身份切换（Human ⇄ Agent，folo 式 segmented toggle） ───────────── */
  .aud { margin-top: 26px; }
  .aud-toggle {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }
  .aud-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(50% - 3px);
    height: calc(100% - 6px);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .aud[data-mode='agent'] .aud-thumb { transform: translateX(100%); }
  .aud-opt {
    position: relative;
    z-index: 1;
    padding: 7px 18px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease);
  }
  .aud-opt:hover { color: var(--text-2); }
  .aud-opt.active { color: var(--text-1); }

  /* 两面板叠放在同一网格格，容器高度恒为较高者 → 切换不跳动，只做交叉淡入 */
  .aud-panels { display: grid; margin-top: 20px; }
  .aud-panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0.3s;
  }
  .aud-panel.active { opacity: 1; visibility: visible; transform: none; }

  .aud-note {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.6;
    color: var(--text-3);
  }

  /* 可复制框（原 agent-band 迁移至此 Agent 面板复用） */
  .copy-block {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 540px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .copy-code {
    flex: 1;
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-1);
    background: transparent;
    text-align: left;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .copy-btn {
    flex-shrink: 0;
    align-self: stretch;
    padding: 0 16px;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-2);
    background: transparent;
    border: 0;
    border-left: 1px solid var(--border);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }
  .copy-btn:hover { color: var(--text-1); }

  /* hero 载入编排：一次性错峰浮入。
     SSR 安全 —— 默认就可见，动画只在「不要求减弱动效」时叠加；
     reduced-motion / 不支持时元素保持默认可见，不会 ship 空白。 */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes hero-in {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-inner > *,
    .hero > .hero-demo { animation: hero-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero-inner > .badge    { animation-delay: 0s; }
    .hero-inner > h1        { animation-delay: 0.07s; }
    .hero-inner > .subtitle { animation-delay: 0.14s; }
    .hero-inner > .tagline  { animation-delay: 0.21s; }
    .hero-inner > .aud      { animation-delay: 0.28s; }
    .hero > .hero-demo      { animation-delay: 0.40s; }
  }

  /* ── shared section heads ─────────────────────────────────────────────── */
  .section-head { max-width: 640px; }
  .section-head h2 {
    font-size: clamp(24px, 3.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-1);
    margin: 0;
    text-wrap: balance;
  }
  .section-sub {
    margin-top: 12px;
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--text-2);
  }

  /* ── roadmap ──────────────────────────────────────────────────────────── */
  .roadmap { padding: clamp(56px, 7vw, 88px) 24px; border-top: 1px solid var(--border); }
  .roadmap-inner { max-width: 1080px; margin: 0 auto; }
  .roadmap-status {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-3);
  }
  .status-dot {
    flex: none;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--warning);
    transform: translateY(-1px);
  }

  .parts {
    margin-top: clamp(36px, 5vw, 52px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(32px, 5vw, 64px);
  }
  @media (max-width: 720px) { .parts { grid-template-columns: 1fr; } }

  .part-head {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding-bottom: 12px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .part-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    letter-spacing: 0.02em;
  }
  .part-title { font-size: var(--text-body); font-weight: 600; color: var(--text-1); letter-spacing: -0.01em; }
  .part-sub { font-size: var(--text-xs); color: var(--text-3); }
  .part-exit {
    margin: 10px 4px 8px;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-2);
  }
  .part-exit span {
    margin-right: 7px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
  }

  .rung {
    display: grid;
    grid-template-columns: 28px 1fr;
    grid-template-areas: 'num title' '. milestone';
    column-gap: 12px;
    row-gap: 2px;
    padding: 11px 8px 11px 4px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease);
  }
  .rung:hover { background: var(--bg-alt); }
  .rung-n {
    grid-area: num;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-3);
    padding-top: 1px;
    transition: color var(--duration-fast) var(--ease);
  }
  .rung:hover .rung-n { color: var(--text-1); }
  .rung-title {
    grid-area: title;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.01em;
  }
  .rung-m {
    grid-area: milestone;
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--text-2);
  }
  .rung-m::before { content: '→ '; color: var(--text-3); }
  .rung-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--warning);
    margin-left: 8px;
    vertical-align: middle;
  }

  .roadmap-more {
    display: inline-block;
    margin-top: clamp(32px, 4vw, 44px);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease), border-color var(--duration-fast) var(--ease);
  }
