---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Footer from '../components/Footer.astro'
import { PARTS, N_TO_SLUG, chapterStatus, STATUS_META } from '../data/chapters'

const stages = ['为什么需要它', '原理拆解', '动手实现', '跑起来看效果', '练习与延伸']
---

<BaseLayout
  title="课程大纲 — Build Your Own AI Agent"
  description="从一次 API 调用到完整 coding agent：按 Part 规划的能力路线与当前章节假设"
>
  <SiteHeader />

  <main class="outline-main" id="main-content">
    <div class="outline-inner">
      <div class="outline-eyebrow">// Part 目标 v0.3 · 章节展开持续修订</div>
      <h1 class="outline-title">从一次 API 调用，到一个几千行的编码 agent</h1>
      <p class="outline-lead">
        Part 按真实任务需求划分：新能力带来新的工程压力，runtime 再承担新的责任。每个 Part 先固定出口，再从真实代码 checkpoint 反推章节。
      </p>

      <div class="outline-contract">
        <div class="contract-label">每章结构</div>
        <ol class="contract-stages">
          {stages.map((s, i) => (
            <li><span class="contract-n">{i + 1}</span>{s}</li>
          ))}
        </ol>
      </div>

      <div class="outline-status">
        <span class="status-note">全书写作中：目前推进序章与第一部分。旧 00–16 条目只按最接近的 Part 临时归类；旧 ch10、ch12 横跨新边界，进入对应 Part 时再重切。</span>
        <div class="status-legend">
          <span class="legend-item"><span class="dot dot-writing"></span>写作中</span>
          <span class="legend-item"><span class="dot dot-planned"></span>暂定</span>
          <span class="legend-item"><span class="dot dot-published"></span>可读</span>
        </div>
      </div>

      <div class="outline-parts">
        {PARTS.map((part) => (
          <section class="outline-part">
            <div class="outline-part-header">
              <span class="outline-part-num">{part.part}</span>
              <h2 class="outline-part-title">{part.title}</h2>
              {part.sub && <span class="outline-part-sub">{part.sub}</span>}
            </div>

            {part.goal && (
              <div class="outline-part-contract">
                <p class="part-goal">{part.goal}</p>
                <dl>
                  <div>
                    <dt>Part 出口</dt>
                    <dd>{part.exit}</dd>
                  </div>
                  <div>
                    <dt>阶段验收</dt>
                    <dd>{part.acceptance}</dd>
                  </div>
                  <div>
                    <dt>明确延后</dt>
                    <dd>{part.deferred}</dd>
                  </div>
                </dl>
              </div>
            )}

            {part.goal && <div class="chapter-hypothesis">// 当前章节素材 · 开发本 Part 前重切并冻结</div>}

            {part.chapters.map((ch) => {
              const slug = N_TO_SLUG[ch.n]
              const status = chapterStatus(ch.n)
              return (
                <a href={`/${slug}`} class="outline-chapter" data-status={status}>
                  <span class="outline-chapter-n">{ch.n}</span>
                  <span class="outline-chapter-body">
                    <span class="outline-chapter-head">
                      <span class="outline-chapter-title">{ch.t}</span>
                      <span class="outline-chapter-status">
                        <span class={`dot dot-${status}`}></span>
                        {STATUS_META[status].label}
                      </span>
                    </span>
                    {ch.m && (
                      <span class="outline-chapter-milestone">
                        <span class="outline-chapter-arrow">里程碑 →</span>
                        {ch.m}
                      </span>
                    )}
                    {ch.desc && (
                      <span class="outline-chapter-desc">{ch.desc}</span>
                    )}
                  </span>
                </a>
              )
            })}
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .outline-main { padding: 56px 24px 96px; }
  .outline-inner { max-width: 720px; margin: 0 auto; }

  .outline-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .outline-title {
    font-size: var(--text-h1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-1);
    line-height: 1.3;
    margin: 0 0 16px;
  }
  .outline-lead {
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--text-2);
    margin: 0 0 28px;
  }

  /* ── 五段式契约 ────────────────────────────────────────────── */
  .outline-contract {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-alt);
    margin-bottom: 20px;
  }
  .contract-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .contract-stages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contract-stages li {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .contract-n {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    flex: none;
  }

  /* ── 状态与图例 ────────────────────────────────────────────── */
  .outline-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 20px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .status-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-3);
    flex: 1;
    min-width: 240px;
  }
  .status-legend { display: flex; gap: 14px; flex: none; }
  .legend-item {
    display: flex; align-items: center; gap: 6px;
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; display: inline-block; }
  .dot-writing { background: var(--warning); }
  .dot-planned { background: transparent; border: 1px solid var(--border-strong); }
  .dot-published { background: var(--text-1); }

  /* ── parts ─────────────────────────────────────────────────── */
  .outline-parts { display: flex; flex-direction: column; gap: 40px; }

  .outline-part-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
    flex-wrap: wrap;
  }
  .outline-part-num { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-3); }
  .outline-part-title {
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-1);
    margin: 0;
  }
  .outline-part-sub { font-size: var(--text-sm); color: var(--text-3); }

  .outline-part-contract {
    margin: 14px 0 12px;
    padding: 16px 18px;
    border-left: 2px solid var(--border-strong);
    background: var(--bg-alt);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .part-goal {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text-1);
  }
  .outline-part-contract dl {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
  }
  .outline-part-contract dl > div {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 10px;
  }
  .outline-part-contract dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
  }
  .outline-part-contract dd {
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.65;
    color: var(--text-2);
  }
  .chapter-hypothesis {
    margin: 16px 8px 4px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
  }

  /* ── chapter row ───────────────────────────────────────────── */
  .outline-chapter {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 14px 8px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: background var(--duration-fast) var(--ease);
  }
  .outline-chapter:hover { background: var(--bg-soft); }
  .outline-chapter[data-status='planned'] { opacity: 0.78; }
  .outline-chapter[data-status='planned']:hover { opacity: 1; }

  .outline-chapter-n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-3);
  }
  .outline-chapter-body { display: flex; flex-direction: column; gap: 5px; }

  .outline-chapter-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .outline-chapter-title {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .outline-chapter-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    transform: translateY(-1px);
  }

  .outline-chapter-milestone {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: 1.5;
  }
  .outline-chapter-arrow {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-3);
    flex: none;
  }
  .outline-chapter-desc {
    font-size: var(--text-sm);
    color: var(--text-3);
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .outline-part-contract dl > div { grid-template-columns: 1fr; gap: 2px; }
    .outline-chapter-head { flex-direction: column; gap: 4px; }
    .outline-chapter-status { transform: none; }
  }
</style>
